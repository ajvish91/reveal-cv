# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/

# Secrets and private data (never commit)
.env
.env.*
!.env.example
private/
**/private/
.tmp_private_cv/
cv_identity_mapping.json
**/cv_identity_mapping.json
# Personal identity regexes for check_safe_to_push.py (template: .privacy_patterns.example)
.privacy_patterns.local
**/cv_real_values.json
**/cv_identity_mapping.example.json.local

# Real CV sources (never commit — use ~/private/cv/cv/, CV_SOURCE_DIR, or local copies below)
shared/cv/industry.md
shared/cv/academic.md
shared/cv/cv_registry.json
shared/cv/user/
# Committed demo templates: shared/cv/industry.demo.md, academic.demo.md

# Generated CV runs (tailored text, PDFs, cover letters)
cv_generation/cv_runs/
**/cv_runs/
**/deanonymized/

# Saved job postings (reveal which roles are being applied for)
cv_generation/jobs/*
# Exception: fictional posting used by scripts/run_demo.py
!cv_generation/jobs/demo_northline_ml_engineer.txt

# Graphify knowledge graph output (generated; indexes job postings by name)
graphify-out/

# Job search local DB and exports
job_search/data/*
!job_search/data/.gitkeep
*.db
*.sqlite
*.sqlite3
*.log

# Local scratch / personal archive (not for git)
archive/

# Cursor chat backups (may contain application PII; never commit)
review_pack/agent-transcripts/
review_pack/transcript_index.json
review_pack/transcript_index.md

# Generated application artifacts (demo/dummy CV, cover letter, proposal)
job_search/cover_letter.md
job_search/final_cv.md
job_search/research_proposal.md

# Documents and exports that may contain PII
*.pdf
*.docx
rough CV*
rough*CV*
teknorge*.csv
teknorge*.html
job_search/teknorge*
**/cover_letter.pdf
**/final_cv.pdf

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp

# Cursor / local only
.cursor/
