# Copy to ~/private/cv/config.env via:  python private_cv.py setup
# Only paths here — real name/email/employers go in cv_identity_mapping.json

# Repository root (contains job_search/, cv_generation/, shared/, .venv/)
CV_PROJECT_DIR="/absolute/path/to/reveal-cv"
CV_PRIVATE_DIR="$HOME/private/cv"
CV_IDENTITY_MAPPING="$HOME/private/cv/cv_identity_mapping.json"
CV_DEANON_OUTPUT="$HOME/private/cv/deanonymized"
CV_PROFILE_PHOTO="$HOME/private/cv/profile_photo.jpg"
